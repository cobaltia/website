# Shrink Docker build context and avoid copying local artifacts

# Dependency directories
node_modules
.pnpm
.pnp
.pnp.cjs
.pnpm-store

# Next.js build output
.next
out

# Build artifacts and caches
dist
.cache
tmp
temp
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files (keep example)
.env
.env*.local
!.env.example

# Tests and coverage
coverage
.nyc_output
jest-cache
jest-results
junit.xml

# Version control
.git
.gitignore
.gitattributes

# Editors and OS files
.vscode
.idea
*.swp
.DS_Store
Thumbs.db

# Docker files themselves (not needed in context)
Dockerfile
Dockerfile.*
.dockerignore
